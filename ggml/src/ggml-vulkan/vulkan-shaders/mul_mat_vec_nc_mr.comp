#version 450

// Multi-row variant of mul_mat_vec_nc for the decode-time KQV product (transposed f16 V
// cache x softmax(KQ), one query token). mul_mat_vec_nc.comp runs one workgroup per
// (head dim element, q head): every workgroup re-reads the whole probability row of its
// q head (n_kv floats, twice the bytes of the V row it multiplies), and the gqa_ratio
// q heads sharing a V head each re-read that V row.
//
// Here a workgroup computes ROWS head-dim elements of one V head for all gqa_ratio q heads
// that share it, so each 16-byte V chunk and each probability chunk is loaded once per
// workgroup and reused ROWS x gqa_ratio times. The n_kv dimension is spread over the
// whole workgroup and reduced with subgroupAdd, then across subgroups in shared memory.
//
// Host requirements: subgroup arithmetic, V row and channel strides multiples of 8 halves,
// probability channel stride and offset multiples of 4 floats, one batch (ne03 == 1),
// ROWS * gqa_ratio a multiple of 4 and at most 32.

#extension GL_EXT_control_flow_attributes : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout(constant_id = 0) const uint WG_SIZE = 256;
// gqa_ratio is in the range [1,8]
layout(constant_id = 1) const uint gqa_ratio = 1;
layout(constant_id = 2) const uint ROWS = 8;

#define MAT_VEC_FUSION_FLAGS_BIAS0 0x1
#define MAT_VEC_FUSION_FLAGS_BIAS1 0x2

#define MAX_ACC 32

layout (binding = 0) readonly buffer A {uvec4 data_a[];};      // 8 x f16 per element
layout (binding = 0) readonly buffer A32 {uint data_a_u32[];}; // 2 x f16 per element
layout (binding = 1) readonly buffer B {float data_b[];};
layout (binding = 1) readonly buffer BV4 {vec4 data_b_v4[];};
layout (binding = 2) writeonly buffer D {float data_d[];};
layout (binding = 3) readonly buffer Fuse0 {float data_fuse0[];};
layout (binding = 4) readonly buffer Fuse1 {float data_fuse1[];};

layout (push_constant) uniform parameter
{
    uint ncols_x;          // n_kv
    uint nrows_x;          // head dim
    uint row_stride_x;     // in halves
    uint channel_stride_x; // in halves
    uint channel_stride_y; // in floats
    uint b_offset;
    uint d_offset;
    uint fusion_flags;
} p;

shared float red_sh[32 * MAX_ACC];

float a_scalar(uint i) {
    const vec2 v = unpackHalf2x16(data_a_u32[i >> 1]);
    return (i & 1) != 0 ? v.y : v.x;
}

void main() {
    const uint tid = gl_LocalInvocationID.x;
    const uint channel_x = gl_WorkGroupID.x;
    const uint channel = channel_x * gqa_ratio;
    const uint row0 = gl_WorkGroupID.y * ROWS;

    float acc[MAX_ACC];
    [[unroll]] for (uint i = 0; i < MAX_ACC; ++i) {
        acc[i] = 0.0f;
    }

    // rows past the end are clamped for loading and never written
    uint abase[ROWS];
    [[unroll]] for (uint r = 0; r < ROWS; ++r) {
        abase[r] = channel_x * p.channel_stride_x + min(row0 + r, p.nrows_x - 1) * p.row_stride_x;
    }

    const uint nchunks = p.ncols_x / 8;
    for (uint ch = tid; ch < nchunks; ch += WG_SIZE) {
        const uint col = ch * 8;
        vec4 pr0[8], pr1[8];
        [[unroll]] for (uint g = 0; g < gqa_ratio; ++g) {
            const uint iy = (p.b_offset + (channel + g) * p.channel_stride_y + col) / 4;
            pr0[g] = data_b_v4[iy];
            pr1[g] = data_b_v4[iy + 1];
        }
        [[unroll]] for (uint r = 0; r < ROWS; ++r) {
            const uvec4 kv = data_a[(abase[r] + col) / 8];
            const vec4 k0 = vec4(unpackHalf2x16(kv.x), unpackHalf2x16(kv.y));
            const vec4 k1 = vec4(unpackHalf2x16(kv.z), unpackHalf2x16(kv.w));
            [[unroll]] for (uint g = 0; g < gqa_ratio; ++g) {
                acc[r * gqa_ratio + g] += dot(k0, pr0[g]) + dot(k1, pr1[g]);
            }
        }
    }
    // tail columns
    for (uint col = nchunks * 8 + tid; col < p.ncols_x; col += WG_SIZE) {
        float pr[8];
        [[unroll]] for (uint g = 0; g < gqa_ratio; ++g) {
            pr[g] = data_b[p.b_offset + (channel + g) * p.channel_stride_y + col];
        }
        [[unroll]] for (uint r = 0; r < ROWS; ++r) {
            const float a = a_scalar(abase[r] + col);
            [[unroll]] for (uint g = 0; g < gqa_ratio; ++g) {
                acc[r * gqa_ratio + g] = fma(a, pr[g], acc[r * gqa_ratio + g]);
            }
        }
    }

    const uint nacc = ROWS * gqa_ratio;
    [[unroll]] for (uint i = 0; i < nacc; i += 4) {
        vec4 t = subgroupAdd(vec4(acc[i], acc[i + 1], acc[i + 2], acc[i + 3]));
        acc[i] = t.x; acc[i + 1] = t.y; acc[i + 2] = t.z; acc[i + 3] = t.w;
    }
    if (subgroupElect()) {
        [[unroll]] for (uint i = 0; i < nacc; ++i) {
            red_sh[gl_SubgroupID * MAX_ACC + i] = acc[i];
        }
    }
    barrier();

    if (tid < nacc) {
        const uint r = tid / gqa_ratio;
        const uint g = tid % gqa_ratio;
        float sum = 0.0f;
        for (uint s = 0; s < gl_NumSubgroups; ++s) {
            sum += red_sh[s * MAX_ACC + tid];
        }
        const uint row = row0 + r;
        if (row < p.nrows_x) {
            // dst is contiguous: [nrows_x, 1, nchannels_y]
            const uint idst = (channel + g) * p.nrows_x + row;
            if ((p.fusion_flags & MAT_VEC_FUSION_FLAGS_BIAS0) != 0) {
                sum += data_fuse0[idst];
            }
            if ((p.fusion_flags & MAT_VEC_FUSION_FLAGS_BIAS1) != 0) {
                sum += data_fuse1[idst];
            }
            data_d[p.d_offset + idst] = sum;
        }
    }
}
